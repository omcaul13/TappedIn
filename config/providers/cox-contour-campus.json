{
  "id": "cox-contour-campus",
  "name": "Cox Contour on Campus",
  "shortName": "Cox",
  "family": "comcast",
  "kind": "campus",
  "status": "experimental",
  "badge": {
    "initials": "CoC",
    "color": "#3f6212"
  },
  "documentedMaxStreams": 1,
  "defaults": {
    "standbyViews": 0
  },
  "notes": "Cox runs the same Comcast TV-APP as Xfinity (PrismCast drives both with one code path), but its guide is watchtv.cox.com/listings. UNVERIFIED: the live-player path (\"/live/\") and whether guide clicks change the URL at all (PrismCast says Cox has no cacheable watch URL). Some entertainment channels open on a \"Watch Now\" play button, which TappedIn presses. Fix these in diagnostics if tuning fails. Cox documents one stream at a time on campus, and campus devices only.",
  "shell": {
    "partition": "persist:cox-contour-campus",
    "userAgent": "chrome",
    "appUrl": "^https://(watchtv|campus)\\.cox\\.com/",
    "playerUrl": "/live/",
    "hideCss": ""
  },
  "signin": {
    "portalUrl": null,
    "autoClick": null,
    "startUrl": "https://campus.cox.com/",
    "checkUrl": "https://watchtv.cox.com/listings",
    "signedOutPattern": "/\\b(Sign In|Log In)\\b/",
    "instructions": "Pick your school and sign in with your school account in the window that opened. TappedIn continues once the Contour guide appears. Live TV only works on the campus network",
    "windowTitle": "TappedIn: sign in to Cox Contour on Campus"
  },
  "errors": {
    "probePatterns": [
      "maximum number of",
      "too many (devices|streams)",
      "stream(ing)? limit",
      "already (watching|streaming)",
      "not available in your (area|location)",
      "only available (on|when connected to)",
      "outside (of )?(your )?(home|campus)",
      "sign in",
      "log in",
      "session (has )?expired",
      "something went wrong",
      "error code",
      "unable to play",
      "playback error",
      "not authorized",
      "not entitled",
      "try again later",
      "still (watching|there)"
    ],
    "loginUrl": "(login|signin|sign-in|oauth|sso|idp|saml|shibboleth|microsoftonline|okta|duosecurity|auth\\.)",
    "limit": "(maximum number of|too many|limit|already (watching|streaming))",
    "unavailable": "(not available|only available|outside|not authorized|not entitled)",
    "loginText": "(sign in|log in|session)",
    "idlePrompt": "still (watching|there)"
  },
  "timing": {
    "loadGapMs": 3500,
    "maxParallelTunes": 2,
    "spareWarmDelayMs": 20000,
    "hidePollMs": 500
  },
  "tuning": {
    "listingsUrl": "https://watchtv.cox.com/listings",
    "livePath": "/live/",
    "rowButton": "tv-grid-row a[role=button]",
    "channelNumber": "tv-grid-row span.channel-number",
    "closePlayer": "#player button[aria-label=\"Close Player\"]",
    "continueWatching": "#player button[aria-label^=\"Are you still watching? Continue\"]",
    "guideErrorPattern": "[^\\n]*TVAPP-\\d+[^\\n]*|Something went wrong[^\\n]*",
    "inAppTimeoutMs": 8000,
    "guideTimeoutMs": 20000,
    "pageTimeoutMs": 30000,
    "closePlayerTimeoutMs": 5000,
    "findRowMaxSteps": 30,
    "findRowSettleMs": 180,
    "findRowHitSettleMs": 120,
    "findRowEmptyWaitMs": 250,
    "callSignInUrl": false,
    "watchNowButton": {
      "selector": "button.style-scope.tv-button",
      "text": "^Watch Now$",
      "waitMs": 5000
    }
  },
  "search": [
    "Cox",
    "Contour",
    "Campus Contour",
    "Providence College",
    "William & Mary",
    "Hollins",
    "Old Dominion"
  ]
}
