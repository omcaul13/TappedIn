{
  "name": "tappedin",
  "version": "0.1.2-beta.2",
  "private": true,
  "type": "module",
  "description": "TappedIn: a multi-game, multi-sport director for the TV service you already have",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "tsx scripts/start.ts",
    "start:chrome": "tsx scripts/start.ts --chrome",
    "sign-electron": "tsx scripts/sign-electron.ts",
    "doctor": "tsx scripts/doctor.ts",
    "postinstall": "tsx scripts/postinstall.ts || exit 0",
    "espn:probe": "tsx scripts/espn-probe.ts",
    "record": "tsx scripts/record.ts",
    "login": "tsx scripts/login.ts",
    "inspect": "tsx scripts/inspect.ts",
    "sim": "tsx scripts/sim.ts",
    "director": "tsx scripts/director.ts",
    "fetch-day": "tsx scripts/fetch-day.ts",
    "make-fixtures": "tsx scripts/make-fixtures.ts",
    "analyze-log": "tsx scripts/analyze-log.ts",
    "switch-stats": "tsx scripts/switch-stats.ts",
    "build-break-model": "tsx scripts/build-break-model.ts",
    "build-tennis-model": "tsx scripts/build-tennis-model.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "provider-check": "tsx scripts/provider-check.ts"
  },
  "dependencies": {
    "@fontsource-variable/overpass": "^5.3.0",
    "json5": "^2.2.3",
    "playwright-core": "^1.64.1",
    "preact": "^10.29.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "electron": "https://github.com/castlabs/electron-releases/archive/refs/tags/v44.5.1%2Bwvcus.tar.gz",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
